import math
from datetime import datetime, timezone

import pandas as pd


# ============================================================
# CONFIGURATION
# ============================================================

PROJECT_ROOT = Path(__file__).resolve().parents[2]

CANONICAL_PATH = PROJECT_ROOT / "data" / "canonical" / "intelligence_data.csv"
EXISTING_ANALYSIS_PATH = (
