"use client";

import { useEffect, useRef } from "react";
import * as echarts from "echarts";

import type { CRMLead } from "@/types/crm";
import { getAverageAgeByStage } from "@/lib/calculations";

type StageAgingProps = {
  data: CRMLead[];
};

const stages = [
  "Lead",
  "Qualified",
  "Opportunity",
  "Proposal",
  "Won",
];

