    "source_name",
    "source_record_id",
    "is_synthetic",
    "data_version",
]

missing_columns = [
    column
    for column in required_columns
    if column not in df.columns
]


# ---------------------------------------------------------
# METADATA VALIDATION
# ---------------------------------------------------------

synthetic_values = (
    df["is_synthetic"]
    .astype(str)
    .str.lower()
    .unique()
    .tolist()
)

data_versions = (
    df["data_version"]
    .astype(str)
    .unique()
    .tolist()
)


# ---------------------------------------------------------
