    "source_name",
    "is_synthetic",
    "data_version",
}


def clean(value):
    if value is None:
        return ""
    return str(value).strip()


def is_missing(value):
    return clean(value) == ""


def parse_number(value):
    value = clean(value)

    if not value:
        return None

    try:
        number = float(value)

        if math.isfinite(number):
            return number

    except (TypeError, ValueError):
        pass

    return None


def parse_date(value):
