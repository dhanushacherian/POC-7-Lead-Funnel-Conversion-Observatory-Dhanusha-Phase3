# ---------------------------------------------------------
# IDENTIFY HIGHEST OBSERVED GROUPS
# ---------------------------------------------------------

highest_value_stage = stage_summary.iloc[0]

highest_value_product = product_summary.iloc[0]

highest_value_source = source_summary.iloc[0]

highest_age_stage = (
