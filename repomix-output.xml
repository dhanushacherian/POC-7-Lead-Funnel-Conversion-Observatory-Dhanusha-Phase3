        return None


def distribution(rows, field):
    counts = {}

    for row in rows:
        value = clean(row.get(field, ""))

        if not value:
            value = "<missing>"

        counts[value] = counts.get(value, 0) + 1

    return dict(
        sorted(
            counts.items(),
            key=lambda item: (-item[1], item[0])
        )
    )


