    and bool(days_numeric.notna().all())
)


# ---------------------------------------------------------
# SOURCE CRM LEADS
# ---------------------------------------------------------

crm_leads = df[
    df["record_type"].astype(str).eq("crm_lead")
].copy()

source_lead_count = int(
    crm_leads["source_record_id"].nunique()
)


# ---------------------------------------------------------
# CANONICAL DIMENSIONS
# ---------------------------------------------------------

products = sorted(
    crm_leads["category"]
    .dropna()
    .astype(str)
    .unique()
    .tolist()
